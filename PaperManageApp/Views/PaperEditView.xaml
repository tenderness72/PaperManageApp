<Page x:Class="PaperManagementApp.Views.PaperEditView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PaperManagementApp.Views"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="800"
      Title="論文編集">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー部分 -->
        <Grid Grid.Row="0" Margin="20,20,20,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="HeaderTextBlock" 
                       Text="新規論文の追加" 
                       FontSize="24" 
                       FontWeight="Bold"/>

            <!-- RISインポートボタン（新規追加時のみ表示） -->
            <Button x:Name="ImportRisButton"
                    Grid.Column="1"
                    Content="RISファイルからインポート"
                    Click="ImportRisButton_Click"
                    Padding="10,5"
                    Margin="10,0,0,0"
                    Background="#3498db"
                    Foreground="White"
                    BorderThickness="0"
                    Visibility="{Binding IsNewMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>

        <!-- フォームコンテンツ -->
        <ScrollViewer Grid.Row="1" Margin="20,10,20,20" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- タブコントロール -->
                <TabControl>
                    <!-- 基本情報タブ -->
                    <TabItem Header="基本情報">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- タイトル -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="タイトル *" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TitleTextBox" Margin="0,5" Padding="5"/>

                            <!-- 著者 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="著者 *" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="AuthorsTextBox" Margin="0,5" Padding="5"
                                     ToolTip="複数著者は・（中黒）で区切ってください。&#x0a;例）山田太郎・鈴木花子・田中次郎&#x0a;英語例）Smith, J. A.・Jones, M. B."/>

                            <!-- 著者よみがな -->
                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">
                                <Run Text="著者よみがな"/>
                                <LineBreak/>
                                <Run Text="（ソート用）" FontSize="10" Foreground="#888"/>
                            </TextBlock>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="AuthorsKanaTextBox" Margin="0,5" Padding="5"
                                     ToolTip="参考文献リストを五十音順にソートするために使用します。&#x0a;著者と同じ・（中黒）で区切ってください。&#x0a;例）やまだ たろう・すずき はなこ"/>

                            <!-- 出版年 -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="出版年 *" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="YearTextBox" Margin="0,5" Padding="5"/>

                            <!-- 雑誌名 -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="雑誌名 *" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="JournalTextBox" Margin="0,5" Padding="5"/>

                            <!-- 巻 -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="巻" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="5" Grid.Column="1" x:Name="VolumeTextBox" Margin="0,5" Padding="5"/>

                            <!-- 号 -->
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="号" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="6" Grid.Column="1" x:Name="IssueTextBox" Margin="0,5" Padding="5"/>

                            <!-- ページ -->
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="ページ" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="7" Grid.Column="1" x:Name="PagesTextBox" Margin="0,5" Padding="5"/>

                            <!-- DOI -->
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="DOI" VerticalAlignment="Center"/>
                            <Grid Grid.Row="8" Grid.Column="1" Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DoiTextBox" Padding="5" Margin="0,0,5,0"/>
                                <Button Grid.Column="1"
                                        x:Name="FetchDoiButton"
                                        Content="DOIから取得"
                                        Click="FetchDoiButton_Click"
                                        Padding="10,5"/>
                            </Grid>

                            <!-- お気に入り -->
                            <TextBlock Grid.Row="9" Grid.Column="0" Text="お気に入り" VerticalAlignment="Center"/>
                            <CheckBox Grid.Row="9" Grid.Column="1" x:Name="FavoriteCheckBox" Margin="0,5" VerticalAlignment="Center"/>

                            <!-- PDFファイル -->
                            <TextBlock Grid.Row="10" Grid.Column="0" Text="PDFファイル" VerticalAlignment="Center"/>
                            <Grid Grid.Row="10" Grid.Column="1" Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PdfPathTextBox" IsReadOnly="True" Padding="5" Margin="0,0,5,0"/>
                                <Button Grid.Column="1" Content="参照..." Click="BrowsePdfButton_Click" Padding="10,5" Margin="0,0,5,0"/>
                                <Button Grid.Column="2" x:Name="AutoFetchFromPdfButton" Content="PDFから自動取得" Click="AutoFetchFromPdfButton_Click" Padding="10,5"/>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- 分類情報タブ -->
                    <TabItem Header="分類情報">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 論文タイプ -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="論文タイプ" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="PaperTypeComboBox" Margin="0,5" Padding="5">
                                <ComboBoxItem Content="研究論文"/>
                                <ComboBoxItem Content="症例報告"/>
                                <ComboBoxItem Content="レビュー"/>
                                <ComboBoxItem Content="解説"/>
                                <ComboBoxItem Content="その他"/>
                            </ComboBox>

                            <!-- 臨床領域 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="臨床領域" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="ClinicalAreaTextBox" Margin="0,5" Padding="5"/>

                            <!-- アプローチ -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="アプローチ" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="ApproachTextBox" Margin="0,5" Padding="5"/>

                            <!-- キーワード -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="キーワード" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="KeywordsTextBox" Margin="0,5" Padding="5"/>

                            <!-- タグ -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="タグ" VerticalAlignment="Center"/>
                            <Border Grid.Row="4" Grid.Column="1"
                                    BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="4"
                                    Margin="0,5" Padding="4" MinHeight="32" Background="White">
                                <WrapPanel x:Name="TagsWrapPanel">
                                    <TextBox x:Name="TagInputTextBox"
                                             MinWidth="120" BorderThickness="0" Padding="3,2"
                                             VerticalAlignment="Center"
                                             ToolTip="タグを入力してEnterで確定"
                                             KeyDown="TagInputTextBox_KeyDown"/>
                                </WrapPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- 論文内容タブ -->
                    <TabItem Header="論文内容">
                        <StackPanel Margin="10">
                            <!-- 要約 -->
                            <TextBlock Text="要約" Margin="0,10,0,5"/>
                            <TextBox x:Name="AbstractTextBox" Height="180" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="5"/>

                            <!-- メモ -->
                            <TextBlock Text="メモ" Margin="0,15,0,5"/>
                            <TextBox x:Name="AdditionalNotesTextBox" Height="180" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="5"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>

        <!-- 操作ボタン -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,20">
            <Button Content="キャンセル" Click="CancelButton_Click" Margin="0,0,10,0" Padding="15,5"/>
            <Button Content="保存" Click="SaveButton_Click" Padding="15,5" Background="#2ecc71" Foreground="White" BorderThickness="0"/>
        </StackPanel>

        <!-- ローディングオーバーレイ（取得中に表示） -->
        <Grid x:Name="LoadingOverlay"
              Grid.Row="0" Grid.RowSpan="3"
              Visibility="Collapsed"
              Background="#88000000"
              Panel.ZIndex="999">
            <Border Background="White"
                    CornerRadius="8"
                    Padding="40,30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="260">
                <StackPanel>
                    <TextBlock x:Name="LoadingStatusText"
                               Text="検索中..."
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>
                    <ProgressBar IsIndeterminate="True"
                                 Height="4"
                                 Width="200"
                                 Foreground="#3498db"
                                 Background="#e0e0e0"
                                 BorderThickness="0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
