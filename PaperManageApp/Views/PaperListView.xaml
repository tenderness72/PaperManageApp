<Page x:Class="PaperManagementApp.Views.PaperListView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PaperManagementApp.Views"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="900"
      Title="論文一覧">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー部分 -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="論文一覧" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1" 
                    Content="新規追加" 
                    Click="AddButton_Click"
                    Padding="15,5" 
                    Background="#27ae60" 
                    Foreground="White" 
                    BorderThickness="0"/>
        </Grid>

        <!-- 論文リスト -->
        <DataGrid x:Name="PapersDataGrid" 
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="PapersDataGrid_SelectionChanged"
                  MouseDoubleClick="PapersDataGrid_MouseDoubleClick"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  BorderBrush="#e0e0e0"
                  RowHeaderWidth="0"
                  Background="White"
                  AlternatingRowBackground="#f9f9f9">

            <DataGrid.Columns>
                <DataGridTemplateColumn Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsFavorite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Checked="FavoriteCheckBox_Checked"
                                      Unchecked="FavoriteCheckBox_Unchecked"
                                      Tag="{Binding Id}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      ToolTip="お気に入り"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="タイトル" 
                                    Binding="{Binding Title}" 
                                    Width="2*"/>

                <DataGridTextColumn Header="著者" 
                                    Binding="{Binding Authors}" 
                                    Width="1*"/>

                <DataGridTextColumn Header="年" 
                                    Binding="{Binding Year}" 
                                    Width="50"/>

                <DataGridTextColumn Header="ジャーナル" 
                                    Binding="{Binding Journal}" 
                                    Width="1*"/>

                <DataGridTextColumn Header="巻・ページ" 
                                    Binding="{Binding Volume}" 
                                    Width="80"/>

                <DataGridTemplateColumn Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="編集" 
                                        Click="EditButton_Click"
                                        Tag="{Binding Id}"
                                        Margin="0,0,5,0"
                                        Padding="5,2"
                                        Background="#3498db"
                                        Foreground="White"
                                        BorderThickness="0"/>

                                <Button Content="削除" 
                                        Click="DeleteButton_Click"
                                        Tag="{Binding Id}"
                                        Padding="5,2"
                                        Background="#e74c3c"
                                        Foreground="White"
                                        BorderThickness="0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="詳細を表示" Click="ViewDetailMenuItem_Click"/>
                    <MenuItem Header="編集" Click="EditMenuItem_Click"/>
                    <MenuItem Header="Wordに引用を挿入" Click="InsertCitationMenuItem_Click"/>
                    <MenuItem Header="削除" Click="DeleteMenuItem_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</Page>