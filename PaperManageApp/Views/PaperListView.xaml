<Page x:Class="PaperManagementApp.Views.PaperListView"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
     xmlns:local="clr-namespace:PaperManagementApp.Views"
     mc:Ignorable="d"
     d:DesignHeight="650" d:DesignWidth="900"
     Title="論文一覧">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー部分 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="論文一覧"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="新規追加"
                    Click="AddButton_Click"
                    Padding="15,5"
                    Background="#27ae60"
                    Foreground="White"
                    BorderThickness="0"/>
        </Grid>

        <!-- 一括操作バー -->
        <Border Grid.Row="1" Margin="0,0,0,8" Padding="10,6"
                Background="#fef9e7" BorderBrush="#f39c12" BorderThickness="1" CornerRadius="4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="SelectAllCheckBox"
                          Click="SelectAllCheckBox_Click"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"
                          ToolTip="すべて選択 / 解除"/>
                <TextBlock x:Name="SelectionCountText"
                           Text="0件選択中"
                           VerticalAlignment="Center"
                           Foreground="#666"
                           Margin="0,0,15,0"/>
                <Button x:Name="BulkDeleteButton"
                        Content="削除"
                        Click="BulkDeleteButton_Click"
                        IsEnabled="False"
                        Padding="12,4"
                        Margin="0,0,6,0"
                        Background="#e74c3c"
                        Foreground="White"
                        BorderThickness="0"/>
                <Button x:Name="BulkFavoriteButton"
                        Content="お気に入り切替"
                        Click="BulkFavoriteButton_Click"
                        IsEnabled="False"
                        Padding="12,4"
                        Background="#f39c12"
                        Foreground="White"
                        BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- 論文リスト -->
        <DataGrid x:Name="PapersDataGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="PapersDataGrid_SelectionChanged"
                  MouseDoubleClick="PapersDataGrid_MouseDoubleClick"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  BorderBrush="#e0e0e0"
                  RowHeaderWidth="0"
                  Background="White"
                  AlternatingRowBackground="#f9f9f9"
                  AllowDrop="True"
                  DragOver="PapersDataGrid_DragOver"
                  Drop="PapersDataGrid_Drop">

            <DataGrid.Columns>
                <!-- 選択チェックボックス列 -->
                <DataGridTemplateColumn Width="35">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Click="SelectionCheckBox_Click"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- お気に入りインジケータ（クリックで個別切替） -->
                <DataGridTemplateColumn Width="35">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Click="StarButton_Click"
                                    Tag="{Binding Id}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Cursor="Hand"
                                    ToolTip="お気に入り切替">
                                <TextBlock FontSize="15" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="☆"/>
                                            <Setter Property="Foreground" Value="#ccc"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Text" Value="★"/>
                                                    <Setter Property="Foreground" Value="#f39c12"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="タイトル"
                                    Binding="{Binding Title}"
                                    Width="2*"/>

                <DataGridTextColumn Header="著者"
                                    Binding="{Binding Authors}"
                                    Width="1*"/>

                <DataGridTextColumn Header="年"
                                    Binding="{Binding Year}"
                                    Width="50"/>

                <DataGridTextColumn Header="ジャーナル"
                                    Binding="{Binding Journal}"
                                    Width="1*"/>

                <DataGridTextColumn Header="巻・ページ"
                                    Binding="{Binding Volume}"
                                    Width="80"/>

                <DataGridTemplateColumn Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="編集"
                                        Click="EditButton_Click"
                                        Tag="{Binding Id}"
                                        Margin="0,0,5,0"
                                        Padding="5,2"
                                        Background="#3498db"
                                        Foreground="White"
                                        BorderThickness="0"/>

                                <Button Content="削除"
                                        Click="DeleteButton_Click"
                                        Tag="{Binding Id}"
                                        Padding="5,2"
                                        Background="#e74c3c"
                                        Foreground="White"
                                        BorderThickness="0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="詳細を表示" Click="ViewDetailMenuItem_Click"/>
                    <MenuItem Header="編集" Click="EditMenuItem_Click"/>
                    <MenuItem Header="Wordに引用を挿入" Click="InsertCitationMenuItem_Click"/>
                    <MenuItem Header="削除" Click="DeleteMenuItem_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</Page>
