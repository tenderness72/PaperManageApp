<Page x:Class="PaperManagementApp.Views.WordExportView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PaperManagementApp.Views"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="900"
      Title="Word連携">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー部分 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Word連携" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Margin="0,0,0,5"/>

            <TextBlock Text="論文の引用をWord文書に挿入できます。" 
                       FontSize="14"/>

            <Border BorderBrush="#e0e0e0" 
                    BorderThickness="1" 
                    Margin="0,15,0,0" 
                    Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Word接続状態" FontWeight="Bold"/>
                        <TextBlock x:Name="WordStatusTextBlock" 
                                   Text="Word未接続" 
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" 
                            x:Name="ConnectWordButton"
                            Content="Wordに接続" 
                            Click="ConnectWordButton_Click"
                            Padding="15,5" 
                            Background="#3498db" 
                            Foreground="White" 
                            BorderThickness="0"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- 論文リスト部分 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 検索部分 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="引用する論文を選択" FontWeight="Bold"/>
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchTextBox" 
                             Padding="5"
                             TextChanged="SearchTextBox_TextChanged"/>

                    <Button Grid.Column="1" 
                            Content="検索" 
                            Margin="5,0,0,0"
                            Padding="15,0"
                            Click="SearchButton_Click"/>
                </Grid>
            </StackPanel>

            <!-- 論文リスト -->
            <DataGrid x:Name="PapersDataGrid" 
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="1"
                      BorderBrush="#e0e0e0"
                      RowHeaderWidth="0"
                      Background="White"
                      AlternatingRowBackground="#f9f9f9">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="タイトル" 
                                        Binding="{Binding Title}" 
                                        Width="2*"/>

                    <DataGridTextColumn Header="著者" 
                                        Binding="{Binding Authors}" 
                                        Width="1*"/>

                    <DataGridTextColumn Header="年" 
                                        Binding="{Binding Year}" 
                                        Width="50"/>

                    <DataGridTextColumn Header="ジャーナル" 
                                        Binding="{Binding Journal}" 
                                        Width="1*"/>

                    <DataGridTemplateColumn Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="本文引用" 
                                            Click="InsertInTextCitationButton_Click"
                                            Tag="{Binding Id}"
                                            Margin="0,0,5,0"
                                            Padding="5,2"
                                            Background="#3498db"
                                            Foreground="White"
                                            BorderThickness="0"
                                            ToolTip="例: 牧村(2006)"/>

                                    <Button Content="文献リスト" 
                                            Click="InsertFullCitationButton_Click"
                                            Tag="{Binding Id}"
                                            Padding="5,2"
                                            Background="#2ecc71"
                                            Foreground="White"
                                            BorderThickness="0"
                                            ToolTip="例: 牧村 雅(2006). 論文タイトル 雑誌名 巻号, pp100-108"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- 文献リスト生成部分 -->
        <Border Grid.Row="2" 
                BorderBrush="#e0e0e0" 
                BorderThickness="1" 
                Margin="0,20,0,0" 
                Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="参考文献リスト生成" FontWeight="Bold"/>
                    <TextBlock Text="データベース内のすべての論文または選択した論文から文献リストを生成し、Word文書に挿入できます。" 
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="すべての論文" 
                            Click="InsertAllReferencesButton_Click"
                            Margin="0,0,5,0"
                            Padding="10,5"/>

                    <Button Content="選択した論文のみ" 
                            Click="InsertSelectedReferencesButton_Click"
                            Padding="10,5" 
                            Background="#2ecc71" 
                            Foreground="White" 
                            BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>