<Window x:Class="PaperManagementApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PaperManagementApp"
        mc:Ignorable="d"
        Title="論文管理システム" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- スタイル定義 -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Background" Value="#3498db"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左側のナビゲーションパネル -->
        <Grid Grid.Column="0" Background="#2c3e50">
            <StackPanel Margin="10">
                <TextBlock Text="論文管理システム" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="White" 
                           Margin="0,20,0,30" 
                           HorizontalAlignment="Center"/>

                <Button Content="すべての論文" 
                        Click="AllPapersButton_Click" 
                        Style="{StaticResource MenuButtonStyle}"/>

                <Button Content="お気に入り" 
                        Click="FavoritesButton_Click" 
                        Style="{StaticResource MenuButtonStyle}"/>

                <Button Content="新しい論文を追加" 
                        Click="AddPaperButton_Click" 
                        Style="{StaticResource MenuButtonStyle}"/>

                <Button Content="Word連携"
                        Click="WordIntegrationButton_Click"
                        Style="{StaticResource MenuButtonStyle}"/>

                <Button Content="設定"
                        Click="SettingsButton_Click"
                        Style="{StaticResource MenuButtonStyle}"/>

                <Separator Margin="0,20" Background="#34495e"/>

                <TextBlock Text="検索" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Foreground="White" 
                           Margin="5,0,0,5"/>

                <TextBox x:Name="SearchTextBox" 
                         Margin="5,5" 
                         Padding="5,3"
                         TextChanged="SearchTextBox_TextChanged"/>

                <TextBlock Text="フィルター" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Foreground="White" 
                           Margin="5,15,0,5"/>

                <ComboBox x:Name="YearFilterComboBox" 
                          Margin="5,5" 
                          SelectionChanged="FilterComboBox_SelectionChanged"
                          DisplayMemberPath="Year"/>

                <ComboBox x:Name="JournalFilterComboBox" 
                          Margin="5,5" 
                          SelectionChanged="FilterComboBox_SelectionChanged"
                          DisplayMemberPath="Journal"/>

                <ComboBox x:Name="ClinicalAreaFilterComboBox"
                          Margin="5,5"
                          SelectionChanged="FilterComboBox_SelectionChanged"
                          DisplayMemberPath="ClinicalArea"/>

                <ComboBox x:Name="TagFilterComboBox"
                          Margin="5,5"
                          SelectionChanged="FilterComboBox_SelectionChanged"/>
            </StackPanel>
        </Grid>

        <!-- メインコンテンツエリア -->
        <Grid Grid.Column="1">
            <Frame x:Name="MainFrame" 
                   NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>